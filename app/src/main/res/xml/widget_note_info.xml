<?xml version="1.0" encoding="utf-8"?>
<!-- One chosen note, about half a screen tall: 10 cells (5 text rows) in Reader's Launcher. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="350dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_note"
    android:configure="com.freedomfighter.readersnotes.widget.NoteWidgetConfigure"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_note_desc" />
